{
  "name": "trpg-voice-bridge-mini",
  "version": "0.7.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "version": "node packaging/version.mjs",
    "version:check": "node packaging/version.mjs --check",
    "start": "node mini.mjs",
    "test": "node --test *.test.mjs src/*.test.mjs discord/*.test.mjs packaging/*.test.mjs mini/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:speech": "node packaging/build-speech.mjs",
    "package:model": "node packaging/model.mjs",
    "package:build": "node packaging/build.mjs",
    "package:smoke": "node packaging/smoke.mjs"
  },
  "dependencies": {
    "opusscript": "0.0.8",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.9.9"
  }
}
